PORT=4000
# MongoDB Atlas URI. Leave empty to use the bundled local MongoDB (first run downloads MongoDB binary).
MONGO_URI=
# Replace with a long random secret before deployment.
JWT_SECRET=change-this-to-a-long-random-secret
CLIENT_URL=http://localhost:5173
# Публичный URL этого backend (для самопинга, чтобы не засыпал). На Render подставляется автоматически.
KEEP_ALIVE_URL=
