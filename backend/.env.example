PORT=4000
# MongoDB Atlas URI. Leave empty for the local embedded MongoDB in development.
MONGO_URI=
# Replace with a long random secret before deployment.
JWT_SECRET=change-this-to-a-long-random-secret
CLIENT_URL=http://localhost:5173
# Configure these two values to create the initial administrator account.
ADMIN_EMAIL=admin@netsveta.dev
ADMIN_PASSWORD=change-this-admin-password
# Public backend URL for self-pinging. Render sets RENDER_EXTERNAL_URL automatically.
KEEP_ALIVE_URL=
